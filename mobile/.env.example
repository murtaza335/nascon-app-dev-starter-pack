# Expo Go on a phone: replace this example with your laptop's hotspot/LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Android emulator alternative: http://10.0.2.2:3000
# Browser development: omit EXPO_PUBLIC_API_URL or use /api for the Expo proxy.
# If backend runs elsewhere, set API_PROXY_TARGET to its full URL as well.
